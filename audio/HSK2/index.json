    "no": "7.0",
    "role": "Nam",
    "voice": "nam",
    "start": 24.13,
    "end": 25.88,
    "text": "三十个题？太多了！",
    "hz": 126,
    "g": "m"
   },
   {
    "no": "8.0",
    "role": "Nữ",
    "voice": "nu",
    "start": 26.68,
    "end": 31.69,
    "text": "不多，这些你们都学过。别笑了，快回家准备吧！",
    "hz": 206,
    "g": "f"
   }
  ]
 },
