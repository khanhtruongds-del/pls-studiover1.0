    "g": "m"
   },
   {
    "no": "4.0",
    "role": "Nữ",
    "voice": "nu",
    "start": 12.26,
    "end": 16.72,
    "text": "不能，也不能上网。你们要准备笔和本子。",
    "hz": 218,
    "g": "f"
   },
   {
    "no": "5.0",
    "role": "Nam",
    "voice": "nam",
    "start": 17.52,
    "end": 19.46,
    "text": "考试有多少个题？",
    "hz": 131,
    "g": "m"
