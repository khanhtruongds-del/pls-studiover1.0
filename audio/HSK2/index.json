 "17|KN-003|快要考试了 (Kuàiyào kǎoshì le)": {
  "file": "B17_KN-003_Kuaiyao-kaoshi-le.mp3",
  "secs": 32.19,
  "lines": [
   {
    "no": "1.0",
    "role": "Nam",
    "voice": "nam",
    "start": 0.4,
    "end": 4.59,
    "text": "老师，我们是今天考试还是明天考试？",
    "hz": 136,
    "g": "m"
   },
   {
    "no": "2.0",
    "role": "Nữ",
    "voice": "nu",
    "start": 5.39,
    "end": 7.87,
    "text": "明天上午考，九点开始。",
    "hz": 224,
    "g": "f"
   },
   {
    "no": "3.0",
    "role": "Nam",
    "voice": "nam",
    "start": 8.67,
    "end": 11.46,
    "text": "考试的时候能看手机吗？",
